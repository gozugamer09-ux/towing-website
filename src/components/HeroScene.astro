---
// The hero's signature graphic: a highway guide sign for Alejos Towing over a road,
// with a flatbed pulling in. Decorative, so hidden from screen readers.
import Icon from './Icon.astro';
import { langOf, UI } from '../lib/i18n';
const { sign } = UI[langOf(Astro.url)];
const { still = false } = Astro.props;
---
<div class="scene" aria-hidden="true">
  <div class="sign">
    <div class="sign-in">
      <div class="sign-top"><span class="shield">24/7</span><span class="sign-sub">{sign.sub.map((w, n) => <>{n > 0 && <br />}{w}</>)}</span></div>
      <div class="sign-name">Alejos<br />Towing</div>
      <div class="sign-exit"><span>{sign.exit}</span><Icon name="arrow" /></div>
    </div>
  </div>
  <div class="posts"><span></span><span></span></div>
  {!still && (
    <div class="road">
      <div class="lanes"></div>
      <svg class="truck" viewBox="0 0 320 112">
        <rect x="10" y="66" width="214" height="12" rx="3" fill="#00653a" stroke="#fff" stroke-width="2"/>
        <path d="M40 66 L52 44 Q56 38 64 38 H150 Q160 38 168 46 L184 60 Q190 66 198 66 Z" fill="#ffc81a"/>
        <path d="M70 44 H112 V60 H62 Z M118 44 H150 Q156 44 160 50 L168 60 H118 Z" fill="#2b2f2c" opacity=".55"/>
        <circle cx="78" cy="66" r="10" fill="#15181a" stroke="#888" stroke-width="3"/>
        <circle cx="164" cy="66" r="10" fill="#15181a" stroke="#888" stroke-width="3"/>
        <path d="M224 30 Q224 22 232 22 H268 Q276 22 280 30 L298 58 Q300 62 300 66 V82 Q300 86 296 86 H224 Z" fill="#00653a" stroke="#fff" stroke-width="2"/>
        <path d="M240 30 H266 L282 56 H240 Z" fill="#cfe3ff" opacity=".85"/>
        <rect x="10" y="78" width="290" height="8" rx="2" fill="#15181a"/>
        <circle cx="48" cy="90" r="14" fill="#15181a" stroke="#9aa0a6" stroke-width="4"/>
        <circle cx="96" cy="90" r="14" fill="#15181a" stroke="#9aa0a6" stroke-width="4"/>
        <circle cx="262" cy="90" r="14" fill="#15181a" stroke="#9aa0a6" stroke-width="4"/>
        <rect x="236" y="13" width="26" height="8" rx="3" fill="#ffc81a"/>
      </svg>
    </div>
  )}
</div>
