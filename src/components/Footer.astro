---
import plate from '../assets/logo/logo-stacked-on-red.svg?url';
import { biz, tel, sms, servicesFor, paymentText } from '../lib/site';
import { langOf, href, alternates, fill, UI } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = UI[lang], f = t.footer;
const other = lang === 'es' ? 'en' : 'es';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div class="ftr-brand">
        <a class="brand" href={href('home', lang)}><img class="logo" src={plate} alt={biz.name} width="240" height="104" loading="lazy" /></a>
        <p>{fill(f.blurb, { year: biz.founded })}</p>
      </div>
      <div class="ftr-contact">
        <h2>{f.contact}</h2>
        <ul>
          <li><a class="big-num num" href={tel} data-track="call-footer">{biz.phoneDisplay}</a></li>
          <li><a href={sms()} data-track="text-footer">{f.text}</a></li>
          <li><a href={`mailto:${biz.email}`}>{biz.email}</a></li>
          <li>{f.city}</li>
        </ul>
      </div>
      <div>
        <h2>{f.services}</h2>
        <ul>{servicesFor(lang).map((s) => <li><a href={s.href}>{s.nav}</a></li>)}</ul>
      </div>
      <div>
        <h2>{f.help}</h2>
        <ul>
          {['request', 'area', 'reviews', 'faq', 'privacy'].map((k) => <li><a href={href(k, lang)}>{t.nav[k]}</a></li>)}
          <li><a href={alternates(Astro.url.pathname)[other]} hreflang={other} lang={other}>{other === 'es' ? 'Español' : 'English'}</a></li>
        </ul>
      </div>
      <div class="ftr-hours">
        <h2>{f.hours}</h2>
        <p><b class="ftr-open">{f.open}</b>{f.hoursText}</p>
        <p>{fill(f.accept, { payment: paymentText(lang) })}</p>
      </div>
    </div>
    <div class="ftr-bottom">
      <span>© {year} {biz.legalName}</span>
      <span>{f.licensed} · {fill(f.usdot, { usdot: biz.usdot })} · {fill(f.insured, { insurer: biz.insurer })}</span>
    </div>
  </div>
</footer>
