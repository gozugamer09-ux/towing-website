---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FloridaMap from '../components/FloridaMap.astro';
import ReviewCard from '../components/ReviewCard.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { biz, tel, reviews } from '../lib/site';
import { langOf, href, UI } from '../lib/i18n';

const lang = langOf(Astro.url);
const t = UI[lang];
const COPY = {
  en: {
    title: 'Towing in Cape Coral, Fort Myers & All of Florida',
    description: 'Based in Southwest Florida. 24/7 towing and roadside help in Cape Coral, Fort Myers and Lee County, plus long-distance tows anywhere in Florida.',
    h1: 'Cape Coral, Fort Myers and anywhere in Florida',
    lede: 'Southwest Florida is home, and most of our calls come from Cape Coral and Fort Myers. When you need to go further, we tow anywhere in the state.',
    localH: 'Cape Coral &amp; Fort Myers',
    local: 'Our home turf in Lee County. Breakdowns, flat tires, dead batteries, lockouts and accidents, around the clock, from neighborhood streets to US-41 and I-75.',
    longH: 'Long-distance, statewide',
    long: 'Broke down far from home, or moving a vehicle between cities? We tow anywhere in Florida, from Naples and Tampa to Orlando, Miami, Jacksonville and the Panhandle.',
    longLink: 'Long-distance towing',
    saidPlate: 'From our customers', saidH: 'Across town or across the state', allReviews: 'Read all reviews',
    final: 'Wherever you are in Florida, call us.',
  },
  es: {
    title: 'Grúa en Cape Coral, Fort Myers y Toda la Florida',
    description: 'En el suroeste de la Florida. Grúa y asistencia en carretera 24/7 en Cape Coral, Fort Myers y el condado de Lee, y remolques de larga distancia a cualquier lugar de la Florida.',
    h1: 'Cape Coral, Fort Myers y toda la Florida',
    lede: 'El suroeste de la Florida es nuestra casa, y la mayoría de las llamadas vienen de Cape Coral y Fort Myers. Si necesita ir más lejos, remolcamos a cualquier lugar del estado.',
    localH: 'Cape Coral y Fort Myers',
    local: 'Nuestra zona en el condado de Lee. Averías, gomas ponchadas, baterías descargadas, llaves adentro y accidentes, a toda hora, desde las calles del barrio hasta la US-41 y la I-75.',
    longH: 'Larga distancia, en todo el estado',
    long: '¿Se le averió el carro lejos de casa o necesita mover un vehículo entre ciudades? Remolcamos a cualquier lugar de la Florida, de Naples y Tampa a Orlando, Miami, Jacksonville y el Panhandle.',
    longLink: 'Remolque de larga distancia',
    saidPlate: 'Nuestros clientes', saidH: 'Al otro lado de la ciudad o del estado', allReviews: 'Leer todas las reseñas',
    final: 'Esté donde esté en la Florida, llámenos.',
  },
};
const c = COPY[lang];
const said = ['fernando-p', 'ysrael-a'].map((id) => reviews.find((r) => r.id === id));
---
<Base title={c.title} description={c.description}>
  <section class="page-head">
    <div class="wrap">
      <nav aria-label={t.breadcrumb}><ol class="crumbs"><li><a href={href('home', lang)}>{t.nav.home}</a></li><li aria-current="page">{t.nav.area}</li></ol></nav>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      <div class="cta-row" data-hide-bar>
        <a class="btn btn-call btn-lg" href={tel} data-track="call-area"><Icon name="phone" />{t.call} <span class="num">{biz.phoneDisplay}</span></a>
        <a class="btn btn-ghost btn-lg" href={href('request', lang)}>{t.request}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap area-grid">
      <FloridaMap />
      <div class="stack stack-lg">
        <div class="stack stack-sm">
          <h2 class="h-sub" set:html={c.localH} />
          <p class="muted">{c.local}</p>
        </div>
        <div class="stack stack-sm">
          <h2 class="h-sub">{c.longH}</h2>
          <p class="muted">{c.long}</p>
          <p><a class="text-link" href={href('service:long-distance-towing', lang)}>{c.longLink}<Icon name="arrow" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec band" aria-labelledby="said-h">
    <div class="wrap">
      <div class="sec-head"><span class="plate">{c.saidPlate}</span><h2 id="said-h">{c.saidH}</h2></div>
      <div class="reviews">
        {said.map((r) => <ReviewCard r={r} original={false} />)}
      </div>
      <p class="reviews-note"><a class="text-link" href={href('reviews', lang)}>{c.allReviews}<Icon name="arrow" /></a></p>
    </div>
  </section>

  <FinalCTA title={c.final} />
</Base>
