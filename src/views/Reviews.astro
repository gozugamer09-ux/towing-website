---
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Icon from '../components/Icon.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Pending from '../components/Pending.astro';
import { biz, reviews } from '../lib/site';
import { langOf, href, fill, UI } from '../lib/i18n';

const lang = langOf(Astro.url);
const t = UI[lang];
const COPY = {
  en: {
    title: 'Customer Reviews',
    description: 'What drivers say about {name}: {n} Google reviews from customers in Cape Coral, Fort Myers and across Florida.',
    h1: 'What drivers say about us',
    lede: 'Real Google reviews from our customers. Most were written in Spanish, so those show our English translation with the original one tap away.',
    rating: '★ {rating} average on Google from {count} reviews', readOnGoogle: 'Read them all on Google', leaveReview: 'Leave us a review',
    finalTitle: "Need us? We're up.", finalText: 'Call or text {phone} any hour, day or night.',
  },
  es: {
    title: 'Reseñas de Clientes',
    description: 'Lo que dicen los conductores de {name}: {n} reseñas de Google de clientes en Cape Coral, Fort Myers y toda la Florida.',
    h1: 'Lo que dicen de nosotros',
    lede: 'Reseñas reales de Google, escritas por nuestros clientes con sus propias palabras. Las pocas que se escribieron en inglés muestran nuestra traducción, con el original a un toque.',
    rating: '★ {rating} de promedio en Google, con {count} reseñas', readOnGoogle: 'Leerlas todas en Google', leaveReview: 'Déjenos una reseña',
    finalTitle: '¿Nos necesita? Aquí estamos.', finalText: 'Llame o escriba al {phone} a cualquier hora, de día o de noche.',
  },
};
const c = COPY[lang];
const vars = { name: biz.name, n: reviews.length, phone: biz.phoneDisplay };
const rating = fill(c.rating, { rating: biz.googleRating ?? '?.?', count: biz.googleReviewCount ?? '??' });
---
<Base title={c.title} description={fill(c.description, vars)}>
  <section class="page-head">
    <div class="wrap">
      <nav aria-label={t.breadcrumb}><ol class="crumbs"><li><a href={href('home', lang)}>{t.nav.home}</a></li><li aria-current="page">{t.nav.reviews}</li></ol></nav>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      {biz.googleRatingConfirmed
        ? <>
            <p class="rating-line">{rating}</p>
            {(biz.googleProfileUrl || biz.googleReviewUrl) && (
              <p class="rating-links">
                {biz.googleProfileUrl && <a class="text-link" href={biz.googleProfileUrl}>{c.readOnGoogle}<Icon name="arrow" /></a>}
                {biz.googleReviewUrl && <a class="text-link" href={biz.googleReviewUrl}><Icon name="star" />{c.leaveReview}</a>}
              </p>
            )}
          </>
        : <Pending block note="Need the exact rating and review count from the Google listing"><p class="rating-line">{rating}</p></Pending>}
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="reviews masonry">{reviews.map((r) => <ReviewCard r={r} />)}</div>
    </div>
  </section>
  <FinalCTA title={c.finalTitle} text={fill(c.finalText, vars)} />
</Base>
