---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { biz, tel } from '../lib/site';
import { langOf, href, UI } from '../lib/i18n';

const lang = langOf(Astro.url);
const t = UI[lang];
const COPY = {
  en: {
    title: 'Page not found', description: "That page doesn't exist.",
    sign: ['Wrong turn', ['Page', 'not found'], 'Turn around'],
    h1: 'That page took a wrong turn.',
    lede: "If you need a tow, don't waste time here. Call us now, or head back to the homepage.",
    home: 'Go to the homepage',
  },
  es: {
    title: 'Página no encontrada', description: 'Esa página no existe.',
    sign: ['Desvío', ['Página', 'perdida'], 'Dé la vuelta'],
    h1: 'Esta página tomó un desvío.',
    lede: 'Si necesita una grúa, no pierda tiempo aquí. Llámenos ahora o vuelva a la página de inicio.',
    home: 'Ir a la página de inicio',
  },
};
const c = COPY[lang];
---
<Base title={c.title} description={c.description} translated={false}>
  <section class="lost">
    <div class="wrap">
      <div class="sign" aria-hidden="true">
        <div class="sign-in">
          <div class="sign-top"><span class="shield">404</span><span class="sign-sub">{c.sign[0]}</span></div>
          <div class="sign-name">{c.sign[1][0]}<br />{c.sign[1][1]}</div>
          <div class="sign-exit"><span>{c.sign[2]}</span><Icon name="arrow" /></div>
        </div>
      </div>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      <div class="cta-row">
        <a class="btn btn-call btn-lg" href={tel}><Icon name="phone" />{t.call} <span class="num">{biz.phoneDisplay}</span></a>
        <a class="btn btn-ghost btn-lg" href={href('home', lang)}>{c.home}</a>
      </div>
    </div>
  </section>
</Base>
