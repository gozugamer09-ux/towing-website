---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroScene from '../components/HeroScene.astro';
import IssuePicker from '../components/IssuePicker.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import FloridaMap from '../components/FloridaMap.astro';
import TrustFacts from '../components/TrustFacts.astro';
import ReviewCard from '../components/ReviewCard.astro';
import RequestForm from '../components/RequestForm.astro';
import FAQList from '../components/FAQList.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Pending from '../components/Pending.astro';
import { biz, tel, sms, services, featuredReviews, homeFaq, reviews } from '../lib/site';
---
<Base title="Alejos Towing | 24/7 Towing in Cape Coral & Fort Myers, FL" fullTitle requestHref="#request">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="status"><span class="dot" aria-hidden="true"></span>Open now · 24 hours, 7 days</span>
        <h1>Stuck on the road? <em>Alejos</em> is on the way.</h1>
        <p class="lede">Towing and roadside help in Cape Coral, Fort Myers and anywhere in Florida. Call or text at any hour, even at 2&nbsp;a.m., and we'll get a truck to you.</p>
        <div class="cta-row" data-hide-bar>
          <a class="btn btn-call btn-lg" href={tel} data-track="call-hero"><Icon name="phone" />Call <span class="num">{biz.phoneDisplay}</span></a>
          <a class="btn btn-ghost btn-lg" href="#request">Request a tow<Icon name="arrow" /></a>
        </div>
        <p class="hero-note"><Icon name="msg" /><span>Can't talk? <a href={sms('Hi, I need a tow. I am at: ')} data-track="text-hero">Text us</a> a photo and your location.</span></p>
      </div>
      <HeroScene />
    </div>
  </section>

  <IssuePicker onPage />

  <section class="sec band" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="sec-head">
        <span class="plate">Services</span>
        <h2 id="svc-h">Whatever stopped you, we can move it.</h2>
        <p class="lede">Cars, SUVs, pickups, vans and motorcycles, from a quick jump start to a heavy-duty tow. <Pending note="Does this apply to heavy-duty jobs too?">Any vehicle under 20 feet.</Pending></p>
      </div>
      <div class="svc-grid compact">{services.map((s) => <ServiceCard s={s} />)}</div>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-h">
    <div class="wrap">
      <div class="sec-head">
        <span class="plate">How it works</span>
        <h2 id="how-h">Three steps from stranded to sorted.</h2>
      </div>
      <Steps />
    </div>
  </section>

  <section class="sec band" aria-labelledby="area-h">
    <div class="wrap area-grid">
      <div class="stack">
        <span class="plate">Service area</span>
        <h2 id="area-h">Local to Southwest Florida. Towing all over the state.</h2>
        <p class="lede">Most calls come from Cape Coral and Fort Myers, but we've picked drivers up on I-75 and taken them all the way to Miami.</p>
        <ul class="areas"><li>Cape Coral</li><li>Fort Myers</li><li>Lee County</li><li>I-75 corridor</li><li>Anywhere in Florida</li></ul>
        <p class="sec-foot"><a class="text-link" href="/service-area/">More about where we tow<Icon name="arrow" /></a></p>
      </div>
      <FloridaMap />
    </div>
  </section>

  <section class="sec" aria-labelledby="trust-h">
    <div class="wrap">
      <div class="sec-head">
        <span class="plate">Why drivers call us</span>
        <h2 id="trust-h">Local, licensed, and there at 2&nbsp;a.m.</h2>
      </div>
      <TrustFacts />
      <div class="reviews">
        {featuredReviews.map((r) => <ReviewCard r={r} />)}
      </div>
      <p class="reviews-note"><a class="text-link" href="/reviews/">Read all {reviews.length} reviews<Icon name="arrow" /></a> <Pending note="Need the Google profile link, rating and review count">· Rated ★ ?.? on Google</Pending></p>
    </div>
  </section>

  <section class="sec band" aria-label="Request a tow">
    <div class="wrap"><RequestForm /></div>
  </section>

  <section class="sec" aria-labelledby="faq-h">
    <div class="wrap split">
      <div class="sec-head split-head">
        <span class="plate">Questions</span>
        <h2 id="faq-h">Good to know before you call.</h2>
        <p class="lede">Can't find your answer? Call or text <a href={tel} class="num strong-link">{biz.phoneDisplay}</a>. Someone picks up 24/7.</p>
        <p><a class="text-link" href="/faq/">All questions<Icon name="arrow" /></a></p>
      </div>
      <FAQList items={homeFaq} openFirst />
    </div>
  </section>

  <FinalCTA requestHref="#request" />
</Base>
