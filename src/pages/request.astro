---
import Base from '../layouts/Base.astro';
import RequestForm from '../components/RequestForm.astro';
import IssuePicker from '../components/IssuePicker.astro';
---
<Base title="Request a Tow" description="Send a tow or roadside request by text in under a minute. Your phone writes the message for you, with a map pin of your location. 24/7 in Cape Coral, Fort Myers and across Florida." requestHref="#request">
  <section class="page-head" style="padding-bottom:clamp(20px,4vw,36px)">
    <div class="wrap">
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Request a tow</li></ol>
    </div>
  </section>
  <section class="sec" style="padding-top:clamp(28px,5vw,56px)">
    <div class="wrap"><RequestForm heading="Request a tow by text." headingLevel={1} /></div>
  </section>
</Base>
