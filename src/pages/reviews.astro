---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Pending from '../components/Pending.astro';
import { biz, tel, reviews } from '../lib/site';
---
<Base title="Customer Reviews" description={`What drivers say about ${biz.name}: ${reviews.length} Google reviews from customers in Cape Coral, Fort Myers and across Florida.`}>
  <section class="page-head">
    <div class="wrap">
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Reviews</li></ol>
      <h1>What drivers say about us</h1>
      <p class="lede">Real Google reviews from our customers. Most were written in Spanish, so each one shows our English translation with the original one tap away.</p>
      <Pending block note="Need the Google profile link, rating and review count"><p style="margin-top:14px;font-weight:700">★ 5.0 average on Google · Read and leave reviews on Google</p></Pending>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="reviews masonry">{reviews.map((r) => <ReviewCard r={r} />)}</div>
    </div>
  </section>
  <FinalCTA title="Need us? We're up." text={`Call or text ${biz.phoneDisplay} any hour, day or night.`} />
</Base>
