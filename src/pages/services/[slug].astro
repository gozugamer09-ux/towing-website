---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServiceSign from '../../components/ServiceSign.astro';
import FAQList from '../../components/FAQList.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { biz, tel, services, paymentText, PREVIEW } from '../../lib/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const i = services.indexOf(s);
const ISSUE_FOR = { towing: 'Breakdown, needs a tow', 'flatbed-towing': 'Breakdown, needs a tow', winching: 'Stuck in a ditch, sand or mud', 'accident-recovery': 'Accident', 'motorcycle-towing': 'Motorcycle tow', 'long-distance-towing': 'Planned or long-distance tow', 'junk-car-removal': 'Junk car removal' };
const requestHref = ISSUE_FOR[s.slug] ? `/request/?issue=${encodeURIComponent(ISSUE_FOR[s.slug])}` : '/request/';
const related = [1, 2, 3].map((k) => services[(i + k) % services.length]);
const site = Astro.site;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: s.title, serviceType: s.title, description: s.intro,
    provider: site ? { '@id': new URL('/#business', site).href } : { '@type': 'AutomotiveBusiness', name: biz.name },
    areaServed: [{ '@type': 'City', name: 'Cape Coral' }, { '@type': 'City', name: 'Fort Myers' }, { '@type': 'State', name: 'Florida' }],
  },
  ...(site ? [{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', site).href },
      { '@type': 'ListItem', position: 3, name: s.title, item: new URL(`/services/${s.slug}/`, site).href },
    ],
  }] : []),
];
---
<Base requestHref={requestHref} title={s.seoTitle} description={`${s.intro} 24/7 in Cape Coral, Fort Myers and across Florida. Call or text ${biz.phoneDisplay}.`} schema={schema}>
  <section class="page-head">
    <div class="wrap page-head-grid">
      <div>
        <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/services/">Services</a></li><li aria-current="page">{s.nav}</li></ol></nav>
        <h1>{s.title}</h1>
        <p class="lede">{s.intro}</p>
        <div class="cta-row" data-hide-bar>
          <a class="btn btn-call btn-lg" href={tel} data-track={`call-${s.slug}`}><Icon name="phone" />Call <span class="num">{biz.phoneDisplay}</span></a>
          <a class="btn btn-ghost btn-lg" href={requestHref}>Request a tow<Icon name="arrow" /></a>
        </div>
      </div>
      <ServiceSign s={s} />
    </div>
  </section>

  <section class="sec">
    <div class="wrap detail-grid">
      <div>
        <h2 class="h-sub spaced">What we handle</h2>
        <ul class="checks">
          {s.includes.map((x) => <li><Icon name="check" /><span>{x}</span></li>)}
          {s.slug === 'towing' && PREVIEW && <li><Icon name="check" /><span class="ph" title="Does this apply to heavy-duty jobs too?">Any vehicle under 20 feet</span></li>}
        </ul>
        <div class="tips">
          {s.goodToKnow.map((t) => <div class="tip"><h3>{t.title}</h3><p>{t.text}</p></div>)}
        </div>
        {s.faq.length > 0 && (
          <div class="detail-faq">
            <h2 class="h-sub spaced">Questions about {s.nav.toLowerCase()}</h2>
            <FAQList items={s.faq} />
          </div>
        )}
      </div>
      <aside class="side-card" aria-label={`Get ${s.nav.toLowerCase()} now`}>
        <b class="display side-title">Need {s.nav.toLowerCase()} now?</b>
        <ul>
          <li><Icon name="clock" />24 hours, 7 days</li>
          <li><Icon name="pin" />Cape Coral, Fort Myers &amp; all of Florida</li>
          <li><Icon name="card" />We accept {paymentText}</li>
        </ul>
        <a class="btn btn-light btn-lg" href={tel} data-track={`call-side-${s.slug}`}><Icon name="phone" />Call <span class="num">{biz.phoneDisplay}</span></a>
        <a class="btn btn-ghost" href={requestHref}>Send a request by text</a>
      </aside>
    </div>
  </section>

  <section class="sec band" aria-labelledby="rel-h">
    <div class="wrap">
      <div class="sec-head"><span class="plate">More services</span><h2 id="rel-h">We can also help with</h2></div>
      <div class="svc-grid compact">{related.map((r) => <ServiceCard s={r} />)}</div>
      <p class="sec-foot"><a class="text-link" href="/services/">All services<Icon name="arrow" /></a></p>
    </div>
  </section>

  <FinalCTA title={`Need ${s.nav.toLowerCase()} right now?`} />
</Base>
