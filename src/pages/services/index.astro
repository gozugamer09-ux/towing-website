---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Steps from '../../components/Steps.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { biz, tel, services } from '../../lib/site';
---
<Base title="Towing & Roadside Services" description="Towing from light to heavy-duty, flatbed, roadside assistance, winching, accident recovery, motorcycle towing, long-distance towing and junk car removal. 24/7 in Cape Coral, Fort Myers and across Florida.">
  <section class="page-head">
    <div class="wrap">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Services</li></ol></nav>
      <h1>Towing and roadside services</h1>
      <p class="lede">Eight ways we get you moving again, any hour of the day or night, in Cape Coral, Fort Myers and anywhere in Florida.</p>
      <div class="cta-row" data-hide-bar>
        <a class="btn btn-call btn-lg" href={tel} data-track="call-services"><Icon name="phone" />Call <span class="num">{biz.phoneDisplay}</span></a>
        <a class="btn btn-ghost btn-lg" href="/request/">Request a tow<Icon name="arrow" /></a>
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="svc-grid">{services.map((s) => <ServiceCard s={s} headingLevel={2} />)}</div>
    </div>
  </section>
  <section class="sec band" aria-labelledby="how-h">
    <div class="wrap">
      <div class="sec-head"><span class="plate">How it works</span><h2 id="how-h">Not sure what you need? Just tell us what happened.</h2><p class="lede">We'll work out whether you need a tow, a flatbed or a quick fix on the spot.</p></div>
      <Steps />
    </div>
  </section>
  <FinalCTA />
</Base>
